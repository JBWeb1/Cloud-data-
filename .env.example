# Port the server listens on (most cloud hosts set this for you)
PORT=3000

# PostgreSQL connection string.
# Local:   postgres://postgres:postgres@localhost:5432/cloud_data
# Hosted:  copy the connection string from Supabase / Neon / Render / RDS
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cloud_data

# Set to true for hosted databases that require SSL
DATABASE_SSL=false

# Set to false to stop new sign-ups (existing users can still log in).
# The first account ever created becomes the admin.
ALLOW_REGISTRATION=true

# How many days a login stays valid
SESSION_TTL_DAYS=30

# Set to 1 when running behind a load balancer / reverse proxy (Render, Railway, Nginx...)
# so rate limits see the real client IP addresses
TRUST_PROXY=

# Allowed origin for browser requests (* allows any)
CORS_ORIGIN=*
